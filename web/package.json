    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
